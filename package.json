{
  "name": "dsh-repo-ops",
  "version": "0.1.1",
  "description": "GitHub and git operations as structured tools: repo status, commits, branches, push, PRs, CI runs and logs, issues, releases.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "git",
    "github",
    "github-cli",
    "ci"
  ],
  "author": "Joker2377",
  "license": "MIT",
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.1.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:spawn": "node --test \"test/**/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joker2377/dsh-repo-ops.git"
  },
  "homepage": "https://github.com/Joker2377/dsh-repo-ops#readme",
  "bugs": {
    "url": "https://github.com/Joker2377/dsh-repo-ops/issues"
  }
}
